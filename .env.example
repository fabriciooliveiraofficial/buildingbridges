# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of your Supabase project (Deprecated, now using local MySQL)
VITE_SUPABASE_URL=
# SUPABASE_ANON_KEY: The public anonymous key for your Supabase project (Deprecated, now using local MySQL)
VITE_SUPABASE_ANON_KEY=

# MYSQL DATABASE CONFIGURATION
PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=building_bridges

# STRIPE GATEWAY CONFIGURATION FOR SECURE LOCAL AND PRODUCTION TRANSACTIONS
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."


# ACCOUNT SECURITY (password reset & security notices by e-mail)
# APP_URL must be the public address of the site: reset links are built ONLY from it.
# Without SMTP_HOST no e-mail is sent; the reset link is printed in the server console instead (dev fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Building Bridges <no-reply@yourdomain.org>"
# Optional: MySQL port (default 3306) and a long random string to sign session tokens
DB_PORT=3306
JWT_SECRET=

# SEO: canonical public address (canonical links, og:url, og:image, sitemap). www.<domain> is redirected to it.
SITE_URL=https://buildingbridgesbrusa.org
